# CultureOwl GraphQL backend — server-side only, never exposed to the browser.
# The Apollo Client always talks to /api/graphql (the BFF route), which
# forwards to this URL. Same backend cultureowl_front uses.
GRAPHQL_BACKEND_URL=http://localhost:3001/graphql
BFF_BACKEND_SECRET=

# JWT httpOnly cookie signing — must match cultureowl_front's values if you
# want a session created by one app to be valid in the other.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Cloudflare Turnstile (bot protection on OTP request)
CLOUDFLARE_TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Set to "true" locally to skip Turnstile verification during development
SKIP_BOT_PROTECTION=false

# Sentry (optional — build works without these, just skips source map upload)
SENTRY_ORG=
SENTRY_PROJECT=
